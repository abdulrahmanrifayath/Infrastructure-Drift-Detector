# Infrastructure Drift Detector Environment Configuration

# App Configuration
PROJECT_NAME="Infrastructure Drift Detector"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drift_detector_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drift_detector_db

# AWS Configuration (Placeholder for future AWS boto3 SDK calls)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI & LLM Engine Settings (Placeholder for future rule engine & LLM modular integration)
AI_ENGINE_PROVIDER=rule_engine
OPENAI_API_KEY=
